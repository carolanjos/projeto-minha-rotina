# vue-jest@4 declara peerDependency jest@26.x (é a última versão do
# vue-jest com suporte real a Vue 2 usando @babel/core 7, ao invés do
# babel-core legado do vue-jest@3). Na prática funciona normalmente com
# jest ^27 (usado aqui para alinhar com o restante do ecossistema
# @vue/cli-service 5 / ts-jest 27). legacy-peer-deps evita que o npm
# recuse a instalação por causa desse conflito de peer dependency.
legacy-peer-deps=true
